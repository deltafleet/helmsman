{
  "name": "@deltafleet/helmsman",
  "version": "0.4.0",
  "description": "Native TUI workbench for route-governed coding-agent autonomy.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deltafleet/helmsman.git"
  },
  "bugs": {
    "url": "https://github.com/deltafleet/helmsman/issues"
  },
  "homepage": "https://github.com/deltafleet/helmsman#readme",
  "bin": {
    "helmsman": "bin/helmsman.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "README.ko.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:pi-runtime && npm run verify:core && npm run verify:tui && npm run verify:question-ui && npm run verify:role-runtime && npm run verify:memory-research && npm run verify:route-lock && npm run verify:autopilot && npm run verify:verification-closeout && npm run verify:product-audit",
    "verify:pi-runtime": "tsx src/verify/pi-runtime-foundation.ts",
    "verify:pi-runtime:live": "tsx src/verify/pi-runtime-foundation.ts --live",
    "verify:core": "tsx src/verify/core-event-reducer-board.ts",
    "verify:tui": "tsx src/verify/tui-workbench.ts",
    "verify:question-ui": "tsx src/verify/question-ui-adapter.ts",
    "verify:role-runtime": "tsx src/verify/role-runtime.ts",
    "verify:role-runtime:live": "tsx src/verify/role-runtime.ts",
    "verify:memory-research": "tsx src/verify/memory-research.ts",
    "verify:route-lock": "tsx src/verify/route-lock-amendment.ts",
    "verify:autopilot": "tsx src/verify/autopilot-loop.ts",
    "verify:verification-closeout": "tsx src/verify/verification-closeout.ts",
    "verify:product-audit": "tsx src/verify/install-doctor-product-audit.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.5",
    "@earendil-works/pi-ai": "0.75.5",
    "@earendil-works/pi-coding-agent": "0.75.5",
    "@earendil-works/pi-tui": "0.75.5",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
